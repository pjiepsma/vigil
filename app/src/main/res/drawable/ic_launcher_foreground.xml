<?xml version="1.0" encoding="utf-8"?>
<!--
  Adaptive-icon foreground (108dp logical canvas). Insets shrink the bitmap so it
  clears the round launcher mask; asymmetric insets nudge art up/right when the PNG’s
  ink sits low-left inside its transparent bounds.
-->
<inset xmlns:android="http://schemas.android.com/apk/res/android"
    android:insetLeft="24dp"
    android:insetTop="14dp"
    android:insetRight="18dp"
    android:insetBottom="26dp">
    <bitmap
        android:gravity="center"
        android:src="@drawable/ic_vigil_brand" />
</inset>
